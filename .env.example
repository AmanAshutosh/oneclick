# Database: PostgreSQL connection string (on Vercel, the Postgres integration sets this).
# Tables are created by `prisma migrate deploy`, which runs as part of `npm run build`.
DATABASE_URL="postgresql://user:password@localhost:5432/oneclick"

# Public URL of the site (used for canonical URLs, sitemap, RSS, OG tags, CSRF origin check)
SITE_URL="http://localhost:3000"
SITE_NAME="OneClick"
SITE_DESCRIPTION="Stories, guides and notes published with OneClick CMS."

# Auth: use a long random string (e.g. `openssl rand -base64 48`)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Site Admin"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=8
